---
import '../styles/global.css';
import ThemeSelect from '../components/ThemeSelect.astro';
import { site } from '../site.config';
import { url } from '../lib/posts';
interface Props { title?: string; description?: string; active?: string; article?: boolean; noindex?: boolean; }
const { title, description = site.description, active = '', article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Resolve the theme before rendering, including on subsequent page loads.
      (() => {
        let preference = 'system';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch {}
        const theme = preference === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#16181d' : '#ffffff');
      })();
    </script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={url('rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={url()} aria-label={`${site.title}首页`}>{site.title}<span aria-hidden="true">.</span></a>
        <p class="site-description">{site.description}</p>
        <div class="header-actions">
          <nav aria-label="主导航">
            <a href={url()} aria-current={active === 'home' ? 'page' : undefined}>文章</a>
            <a href={url('archive/')} aria-current={active === 'archive' ? 'page' : undefined}>归档</a>
            <a href={url('about/')} aria-current={active === 'about' ? 'page' : undefined}>关于</a>
          </nav>
          <ThemeSelect />
        </div>
      </header>
      <main id="main" class:list={{ 'reading-page': article }}><slot /></main>
      <footer class="site-footer"><span>© {new Date().getUTCFullYear()} {site.title}. All rights reserved.</span><a href={url('about/')}>关于本站</a></footer>
    </div>
  </body>
</html>
