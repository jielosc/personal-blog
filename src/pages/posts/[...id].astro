---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, titleOf, excerptOf, formatDate, readingTime, postUrl, url } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, next: posts[i + 1] } }));
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const title = titleOf(post);
const hasLeadingTitle = /^\s*#\s+.+(?:\r?\n|$)/.test(post.body || '');
---
<Base title={title} description={excerptOf(post)} article>
  <div class="article-top"><a href={url()}>所有文章</a></div>
  <header class="article-heading">
    <h1>{title}</h1>
    <div class="post-meta">
      {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
      <span>{readingTime(post)} 分钟阅读</span>
      <span class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</span>
    </div>
    {post.data.description && <p>{post.data.description}</p>}
  </header>
  {toc.length > 0 && <details class="toc"><summary>文章目录 <span>{toc.length}</span></summary><nav aria-label="文章目录"><ol>{toc.map(h => <li class:list={{ nested: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>}
  <article class:list={['prose', { 'has-leading-title': hasLeadingTitle }]}><Content /></article>
  {next && <footer class="article-end"><span>下一篇</span><a href={postUrl(next.id)}>{titleOf(next)}</a></footer>}
</Base>
