---
import type { CollectionEntry } from 'astro:content';
import { titleOf, excerptOf, postUrl, formatDate } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
---
<article class="post-row">
  <div class="post-summary">
    <h2><a href={postUrl(post.id)}>{titleOf(post)}</a></h2>
    <p>{excerptOf(post)}</p>
    <div class="post-meta">
      {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
      {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</span>}
    </div>
  </div>
</article>
