<fieldset class="theme-control" hidden>
  <legend class="visually-hidden">外观主题</legend>
  <span class="theme-thumb" aria-hidden="true"></span>
  <label class="theme-option">
    <input class="visually-hidden" type="radio" name="theme" value="system" checked />
    <span class="theme-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
    </span>
    <span class="visually-hidden">跟随系统</span>
    <span class="theme-tooltip" aria-hidden="true">跟随系统</span>
  </label>
  <label class="theme-option">
    <input class="visually-hidden" type="radio" name="theme" value="light" />
    <span class="theme-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" /></svg>
    </span>
    <span class="visually-hidden">浅色</span>
    <span class="theme-tooltip" aria-hidden="true">浅色</span>
  </label>
  <label class="theme-option">
    <input class="visually-hidden" type="radio" name="theme" value="dark" />
    <span class="theme-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13a9 9 0 1 1-9.9-9.9A7 7 0 0 0 20.9 13Z" /></svg>
    </span>
    <span class="visually-hidden">深色</span>
    <span class="theme-tooltip" aria-hidden="true">深色</span>
  </label>
</fieldset>

<script>
  const root = document.documentElement;
  const control = document.querySelector<HTMLFieldSetElement>('.theme-control');
  const options = control?.querySelectorAll<HTMLInputElement>('input[name="theme"]');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

  function applyTheme(preference: string) {
    const theme = preference === 'system' ? (systemTheme.matches ? 'dark' : 'light') : preference;
    root.dataset.themePreference = preference;
    root.dataset.theme = theme;
    options?.forEach(option => { option.checked = option.value === preference; });
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute(
      'content', theme === 'dark' ? '#16181d' : '#ffffff',
    );
  }

  applyTheme(root.dataset.themePreference || 'system');
  if (control) control.hidden = false;

  control?.addEventListener('change', (event) => {
    const option = event.target;
    if (!(option instanceof HTMLInputElement) || option.name !== 'theme') return;
    applyTheme(option.value);
    try {
      if (option.value === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', option.value);
    } catch {
      // Switching still works when browser storage is unavailable.
    }
  });

  systemTheme.addEventListener('change', () => {
    if (root.dataset.themePreference === 'system') applyTheme('system');
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== 'theme' && event.key !== null) return;
    const preference = event.newValue;
    applyTheme(preference === 'light' || preference === 'dark' ? preference : 'system');
  });
</script>
